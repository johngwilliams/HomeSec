<Window x:Class="HomeSec.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HomeSec.App.ViewModels"
        xmlns:conv="clr-namespace:HomeSec.App.Converters"
        Title="HomeSec — Home Network Security Scanner"
        Width="1100" Height="750"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:SeverityToColorConverter x:Key="SeverityToColor" />
        <conv:SeverityToBackgroundConverter x:Key="SeverityToBackground" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="HomeSec" FontSize="22" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Home Network Security Scanner" FontSize="12" Foreground="#A0C4E8" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Scan Network"
                            Style="{StaticResource ScanButton}"
                            Command="{Binding StartScanCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource InvBoolToVis}}" />
                    <Button Content="Stop Scan"
                            Style="{StaticResource StopButton}"
                            Command="{Binding StopScanCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress bar -->
        <Grid Grid.Row="1" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
            <ProgressBar Value="{Binding ScanProgress}" Maximum="100" Height="4"
                         Foreground="{StaticResource AccentBrush}" Background="#E2E8F0"
                         BorderThickness="0" />
        </Grid>

        <!-- Network info + summary stats -->
        <Border Grid.Row="2" Padding="20,12" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Subnet info -->
                <TextBlock Grid.Row="0" Text="{Binding SubnetInfo}" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                <!-- Summary cards -->
                <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,4">
                    <!-- Devices found -->
                    <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalDevices}" Style="{StaticResource StatValue}" HorizontalAlignment="Center" />
                            <TextBlock Text="Devices Found" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Total findings -->
                    <Border Style="{StaticResource Card}" Margin="3,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalFindings}" Style="{StaticResource StatValue}" HorizontalAlignment="Center" />
                            <TextBlock Text="Total Findings" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Critical -->
                    <Border Style="{StaticResource Card}" Margin="3,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding CriticalCount}" Style="{StaticResource StatValue}"
                                       Foreground="{StaticResource CriticalBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Critical" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- High -->
                    <Border Style="{StaticResource Card}" Margin="3,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding HighCount}" Style="{StaticResource StatValue}"
                                       Foreground="{StaticResource HighBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="High" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Medium -->
                    <Border Style="{StaticResource Card}" Margin="3,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding MediumCount}" Style="{StaticResource StatValue}"
                                       Foreground="{StaticResource MediumBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Medium" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Overall risk -->
                    <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding OverallRisk}" Style="{StaticResource StatValue}"
                                       Foreground="{Binding OverallRisk, Converter={StaticResource SeverityToColor}}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Overall Risk" Style="{StaticResource StatLabel}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Main content: device list + detail panel -->
        <Grid Grid.Row="3" Margin="20,12,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="350" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.2*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <!-- Device list -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Discovered Devices" Style="{StaticResource SectionHeader}" />
                    <ListBox ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Category icon (Segoe MDL2 Assets) -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding CategoryIcon}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="24"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />

                                    <!-- Name + IP -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding IpAddress}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text=" | " FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding CategoryName}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Finding count badge -->
                                    <Border Grid.Column="2" CornerRadius="10"
                                            Background="{Binding HighestSeverity, Converter={StaticResource SeverityToBackground}}"
                                            Padding="8,2" VerticalAlignment="Center"
                                            Visibility="{Binding FindingCount, Converter={StaticResource BoolToVis}}">
                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding HighestSeverity, Converter={StaticResource SeverityToColor}}">
                                            <Run Text="{Binding FindingCount, Mode=OneWay}" />
                                            <Run Text="finding(s)" />
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" Background="Transparent"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- Detail panel -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <!-- No selection state -->
                    <TextBlock Text="Select a device to view details"
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SelectedDevice, Converter={StaticResource InvBoolToVis}}" />

                    <!-- Device detail -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedDevice, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding SelectedDevice}">
                            <!-- Device header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="{Binding CategoryIcon}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="32" Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding CategoryName}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Info grid -->
                            <Border Background="{StaticResource BackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="IP Address:" FontWeight="SemiBold" FontSize="12" Margin="0,2" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding IpAddress}" FontSize="12" Margin="0,2" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="MAC Address:" FontWeight="SemiBold" FontSize="12" Margin="0,2" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MacAddress}" FontSize="12" Margin="0,2" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Vendor:" FontWeight="SemiBold" FontSize="12" Margin="0,2" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Vendor}" FontSize="12" Margin="0,2" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="OS:" FontWeight="SemiBold" FontSize="12" Margin="0,2" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding OperatingSystem}" FontSize="12" Margin="0,2" />
                                </Grid>
                            </Border>

                            <!-- Open ports -->
                            <TextBlock Text="Open Ports" Style="{StaticResource SectionHeader}" />
                            <ItemsControl ItemsSource="{Binding OpenPorts}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="4"
                                                Padding="10,6" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Port}" FontWeight="Bold" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{Binding ServiceName}" FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Protocol}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Security findings -->
                            <TextBlock Text="Security Findings" Style="{StaticResource SectionHeader}" />
                            <ItemsControl ItemsSource="{Binding Findings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="12" Margin="0,4"
                                                BorderThickness="1"
                                                BorderBrush="{Binding Severity, Converter={StaticResource SeverityToColor}}"
                                                Background="{Binding Severity, Converter={StaticResource SeverityToBackground}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border CornerRadius="3" Padding="6,2"
                                                            Background="{Binding Severity, Converter={StaticResource SeverityToColor}}">
                                                        <TextBlock Text="{Binding Severity}" Foreground="White"
                                                                   FontSize="10" FontWeight="Bold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8" />
                                                <Border Background="White" CornerRadius="4" Padding="10,8">
                                                    <StackPanel>
                                                        <TextBlock Text="Recommended Fix:" FontWeight="SemiBold" FontSize="11"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                                        <TextBlock Text="{Binding Recommendation}" FontSize="12" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- No findings message -->
                            <TextBlock Text="No security issues found for this device."
                                       FontSize="13" Foreground="{StaticResource GoodBrush}"
                                       Margin="0,8,0,0"
                                       FontStyle="Italic">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FindingCount}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{StaticResource PrimaryBrush}" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#A0C4E8" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ScanProgressText}" Foreground="#A0C4E8" FontSize="12"
                           VerticalAlignment="Center" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
